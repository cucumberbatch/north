<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.cucumberbatch.north</groupId>
        <artifactId>north</artifactId>
        <version>${revision}</version>
    </parent>

    <name>North Desktop App</name>
    <description>Desktop launcher and composition root for North Engine</description>

    <artifactId>north-app-desktop</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>io.github.cucumberbatch.north</groupId>
            <artifactId>north-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.cucumberbatch.north</groupId>
            <artifactId>north-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>io.github.cucumberbatch.north.architecture.Application</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>
                                lwjgl-natives-windows,lwjgl-natives-linux,lwjgl-natives-macos,
                                lwjgl-assimp-natives-windows,lwjgl-assimp-natives-linux,lwjgl-assimp-natives-macos,
                                lwjgl-glfw-natives-windows,lwjgl-glfw-natives-linux,lwjgl-glfw-natives-macos,
                                lwjgl-openal-natives-windows,lwjgl-openal-natives-linux,lwjgl-openal-natives-macos,
                                lwjgl-opengl-natives-windows,lwjgl-opengl-natives-linux,lwjgl-opengl-natives-macos,
                                lwjgl-stb-natives-windows,lwjgl-stb-natives-linux,lwjgl-stb-natives-macos
                            </excludeArtifactIds>
                        </configuration>
                    </execution>

                    <execution>
                        <id>copy-native-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/natives</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                            <includeArtifactIds>
                                lwjgl-natives-windows,lwjgl-natives-linux,lwjgl-natives-macos,
                                lwjgl-assimp-natives-windows,lwjgl-assimp-natives-linux,lwjgl-assimp-natives-macos,
                                lwjgl-glfw-natives-windows,lwjgl-glfw-natives-linux,lwjgl-glfw-natives-macos,
                                lwjgl-openal-natives-windows,lwjgl-openal-natives-linux,lwjgl-openal-natives-macos,
                                lwjgl-opengl-natives-windows,lwjgl-opengl-natives-linux,lwjgl-opengl-natives-macos,
                                lwjgl-stb-natives-windows,lwjgl-stb-natives-linux,lwjgl-stb-natives-macos
                            </includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
