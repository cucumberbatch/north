    <dependencies>
        <dependency>
            <groupId>io.github.cucumberbatch.north</groupId>
            <artifactId>north-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.cucumberbatch.north</groupId>
            <artifactId>north-asset</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.cucumberbatch.north</groupId>
            <artifactId>north-graphics-api</artifactId>
